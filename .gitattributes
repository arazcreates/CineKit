# Normalize line endings for text files: store as LF in the repo, so the
# project stays consistent across Windows/macOS/Linux with no CRLF churn.
* text=auto eol=lf

# Binary assets: never apply text or end-of-line filters to these, or Git
# will corrupt them. "-text" hard-unsets the text attribute.
*.png   -text
*.jpg   -text
*.jpeg  -text
*.blend -text
*.zip   -text
